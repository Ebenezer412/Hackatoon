{
  "env": {
    "browser": true,
    "es2021": true,
    "jest": true
  },
  "extends": ["eslint:recommended", "prettier"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "globals": {
    "Chart": "readonly",
    "L": "readonly",
    "tailwind": "writable"
  },
  "rules": {
    "no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^(showPage|showTopic|validateForm|sanitizeInput|isValidEmail|initializeApp|initCharts|initMap)"
      }
    ],
    "no-console": [
      "warn",
      {
        "allow": ["warn", "error", "info"]
      }
    ],
    "eqeqeq": ["error", "always"],
    "curly": ["error", "all"],
    "semi": ["error", "always"],
    "quotes": ["error", "single"],
    "indent": ["error", 4],
    "no-var": ["error"],
    "prefer-const": ["warn"],
    "no-empty": ["warn"],
    "no-implicit-coercion": ["warn"],
    "no-param-reassign": ["warn"]
  }
}

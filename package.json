{
  "name": "terraviva",
  "version": "2.0.0",
  "description": "Plataforma educativa interativa sobre degradação do solo e soluções sustentáveis",
  "main": "index.html",
  "type": "module",
  "scripts": {
    "start": "python -m http.server 8000",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint js/ --fix",
    "format": "prettier --write \"js/**/*.js\" \"css/**/*.css\" \"*.html\"",
    "dev": "concurrently \"npm start\" \"npm run test:watch\"",
    "build": "echo 'Build process for production'",
    "analyze": "npm run test:coverage && npm run lint"
  },
  "keywords": [
    "degradação do solo",
    "sustentabilidade",
    "educação ambiental",
    "Angola",
    "ODS 15"
  ],
  "author": "Ebenzer Vilola",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ebenezer412/Hackatoon.git"
  },
  "bugs": {
    "url": "https://github.com/Ebenezer412/Hackatoon/issues"
  },
  "homepage": "https://github.com/Ebenezer412/Hackatoon#readme",
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.0.0",
    "concurrently": "^8.2.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "collectCoverage": true,
    "collectCoverageFrom": [
      "js/**/*.js",
      "!js/**/*.min.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    },
    "testPathIgnorePatterns": [
      "/node_modules/"
    ]
  },
  "eslintConfig": {
    "env": {
      "browser": true,
      "es2021": true,
      "jest": true
    },
    "extends": [
      "eslint:recommended",
      "prettier"
    ],
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module"
    },
    "rules": {
      "no-unused-vars": [
        "warn",
        {
          "argsIgnorePattern": "^_"
        }
      ],
      "no-console": [
        "warn",
        {
          "allow": [
            "warn",
            "error"
          ]
        }
      ],
      "eqeqeq": [
        "error",
        "always"
      ],
      "curly": [
        "error",
        "all"
      ]
    }
  },
  "prettier": {
    "semi": true,
    "trailingComma": "es5",
    "singleQuote": true,
    "printWidth": 100,
    "tabWidth": 4,
    "useTabs": false,
    "arrowParens": "always"
  },
  "dependencies": {
    "chart.js": "^4.4.0",
    "leaflet": "^1.9.4"
  }
}
